# ── Base de datos ─────────────────────────────────────────────────────────────
# Local (SQLite)
DATABASE_URL="file:./dev.db"
DATABASE_URL_UNPOOLED="file:./dev.db"

# Producción (Neon PostgreSQL) — reemplazar con tus URLs de neon.tech
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"

# ── Auth.js ───────────────────────────────────────────────────────────────────
AUTH_SECRET="genera-con: openssl rand -base64 32"

# Google OAuth — console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Pagos ─────────────────────────────────────────────────────────────────────
# PayPal — developer.paypal.com ("sb" = sandbox para pruebas)
NEXT_PUBLIC_PAYPAL_CLIENT_ID="sb"

# WhatsApp del negocio (sin + ni espacios, con lada de país)
NEXT_PUBLIC_WHATSAPP_NUMBER="521XXXXXXXXXX"
